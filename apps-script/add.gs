function safeText_(v,max){let s=String(v||'').slice(0,max);if(/^\s*[=+@-]/.test(s))s="'"+s;return s}
function escapeHtml_(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
